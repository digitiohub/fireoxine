// FireOxine — data model
//
// Money is stored as integer paise everywhere. Never a Float: 2400.10 in
// binary floating point is not 2400.10, and a catalogue that quotes GST-
// inclusive prices cannot afford the drift.
//
// The model that carries the product's positioning is ProductFireClass:
// it records BOTH what a unit covers and what it must never be used on,
// because "do not use water on an electrical fire" is the single most
// safety-critical fact this site publishes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres in every environment, including local development. Running one
  // engine in development and another in production is how a query that works
  // on your laptop fails in front of a customer: SQLite and Postgres disagree
  // on case sensitivity, on transaction isolation and on concurrent writes,
  // and this codebase depends on all three.
  //
  // For a local database:
  //   docker run -d --name fireoxine-pg -p 5432:5432 \
  //     -e POSTGRES_USER=fireoxine -e POSTGRES_PASSWORD=fireoxine \
  //     -e POSTGRES_DB=fireoxine postgres:16-alpine
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- people

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  cart      CartItem[]
  wishlist  WishlistItem[]

  @@index([role])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)

  orders Order[]

  @@index([userId])
}

// ------------------------------------------------------------- catalogue

/// The extinguishing agent inside the cylinder. Distinct from fire class:
/// the medium is what the product IS, the class is what it is FOR.
enum Medium {
  ABC_POWDER
  BC_POWDER
  CO2
  MECHANICAL_FOAM
  WATER
  WATER_MIST
  CLEAN_AGENT
  WET_CHEMICAL
  D_CLASS_POWDER
  NOT_APPLICABLE
}

/// Product families, mirroring the reference site's category axis.
model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  tagline     String?
  description String?
  /// Uploaded through admin. Null until the client provides artwork.
  imageUrl    String?
  position    Int     @default(0)
  isActive    Boolean @default(true)

  products Product[]

  @@index([isActive, position])
}

/// The second door into the catalogue: where the fire would actually start.
/// This is the axis a buyer thinks in ("my kitchen", "my server room")
/// and the reference site's "shop by concern" equivalent.
model Hazard {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  summary     String
  description String?
  /// Key for the drawn pictogram; never a photograph, so it exists at launch.
  pictogram   String
  imageUrl    String?
  position    Int     @default(0)
  isActive    Boolean @default(true)

  products ProductHazard[]

  @@index([isActive, position])
}

/// A, B, C, D, K. Seeded reference data, editable in admin but not deletable
/// in practice — these are statutory classifications, not merchandising.
model FireClass {
  id          String @id @default(cuid())
  code        String @unique
  label       String
  description String
  /// Plain-language example, for the buyer who does not know the vocabulary.
  example     String
  position    Int    @default(0)

  products ProductFireClass[]
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  sku              String   @unique
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  shortDescription String
  description      String
  medium           Medium   @default(ABC_POWDER)

  /// Certification is a first-class product attribute here, not fine print.
  isIsiMarked  Boolean @default(false)
  /// e.g. "IS 15683" — the Indian Standard the unit is manufactured to.
  standardCode String?
  /// Free text for warranty, refill interval, mounting notes.
  warrantyNote String?
  refillMonths Int?

  /// NOT a fire class. Under IS 2190 the classes are A, B, C, D and K, and
  /// "electrical" is a hazard condition, not a class -- a distinction Indian
  /// retail copy routinely gets wrong. Modelling it as its own boolean keeps
  /// the class table statutory and still lets a buyer filter for the thing
  /// they actually care about: can I use this on live equipment.
  safeOnLiveElectrical Boolean @default(false)
  /// Dielectric test rating in kilovolts, where the manufacturer declares one.
  electricalRatingKv   Int?

  isFeatured Boolean  @default(false)
  isActive   Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  variants    ProductVariant[]
  images      ProductImage[]
  fireClasses ProductFireClass[]
  hazards     ProductHazard[]
  wishlisted  WishlistItem[]

  @@index([categoryId, isActive])
  @@index([isFeatured, isActive])
}

/// Coverage AND prohibition in one table.
/// `covers = true`  -> this unit is rated for that class.
/// `covers = false` -> this unit must NOT be used on that class.
/// A product row that simply omits a class says nothing either way, which is
/// different from, and less useful than, an explicit prohibition.
model ProductFireClass {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  fireClassId String
  fireClass   FireClass @relation(fields: [fireClassId], references: [id], onDelete: Cascade)
  covers      Boolean   @default(true)

  @@unique([productId, fireClassId])
  @@index([fireClassId, covers])
}

model ProductHazard {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  hazardId  String
  hazard    Hazard  @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  /// Ordering within a hazard page: the unit we would recommend first.
  rank      Int     @default(0)

  @@unique([productId, hazardId])
  @@index([hazardId, rank])
}

/// Capacity is the variant axis for this category, the way size is for
/// apparel: the same extinguisher in 1 kg, 2 kg, 4 kg, 6 kg, 9 kg.
model ProductVariant {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Display label, e.g. "4 kg" or "9 litre".
  label        String
  capacity     Float
  capacityUnit String  @default("kg")
  sku          String  @unique
  /// Selling price in paise, GST inclusive.
  pricePaise   Int
  /// Struck-through MRP in paise. Null when there is no discount to show.
  mrpPaise     Int?
  stock        Int     @default(0)
  isDefault    Boolean @default(false)
  position     Int     @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, position])
}

/// Every image on the site arrives here, uploaded through /admin.
/// Until then the UI renders a designed pending unit — never a broken box.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId, position])
}

// ------------------------------------------------------------- commerce

model CartItem {
  id        String         @id @default(cuid())
  /// Exactly one of userId / sessionId is set: signed-in cart, or guest cart
  /// keyed by an httpOnly cookie that survives until they sign in.
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
  @@unique([sessionId, variantId])
  @@index([sessionId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  email       String
  phone       String
  addressId   String?
  address     Address? @relation(fields: [addressId], references: [id])
  /// Address is also copied inline: a customer editing their address book
  /// must not silently rewrite where a shipped order actually went.
  shipName    String
  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipState   String
  shipPincode String

  status        OrderStatus @default(PENDING)
  subtotalPaise Int
  shippingPaise Int         @default(0)
  totalPaise    Int
  notes         String?
  placedAt      DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items OrderItem[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  /// Denormalised on purpose: an order line must still read correctly after
  /// the product is renamed, repriced, or deleted from the catalogue.
  productName    String
  variantLabel   String
  sku            String
  unitPricePaise Int
  quantity       Int
  lineTotalPaise Int

  @@index([orderId])
}

// --------------------------------------------------------------- inbound

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model PartnerEnquiry {
  id            String        @id @default(cuid())
  businessName  String
  contactPerson String
  email         String
  phone         String
  businessType  String
  city          String
  state         String
  gstNumber     String?
  monthlyVolume String?
  message       String?
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())

  @@index([status, createdAt])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------- cms

enum FaqGroup {
  GENERAL
  PARTNER
}

model Faq {
  id       String   @id @default(cuid())
  question String
  answer   String
  group    FaqGroup @default(GENERAL)
  position Int      @default(0)
  isActive Boolean  @default(true)

  @@index([group, position])
}

/// Editable copy and contact details, so the client can change the phone
/// number or the hero line without a deploy.
model SiteSetting {
  key   String @id
  value String
  label String
  group String @default("general")
}
