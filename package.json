{
  "name": "fireoxine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db && prisma db push && npm run db:seed",
    "db:studio": "prisma studio",
    "placeholders:on": "tsx prisma/attach-placeholders.ts",
    "placeholders:off": "tsx prisma/clear-placeholders.ts",
    "build:check": "NEXT_DIST_DIR=.next-check next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@prisma/client": "6.16.2",
    "next-auth": "5.0.0-beta.29",
    "@auth/prisma-adapter": "2.10.0",
    "bcryptjs": "3.0.2",
    "zod": "4.1.11",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1",
    "lucide-react": "0.544.0",
    "next-themes": "0.4.6",
    "sonner": "2.0.7"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/bcryptjs": "2.4.6",
    "prisma": "6.16.2",
    "tailwindcss": "4.1.13",
    "@tailwindcss/postcss": "4.1.13",
    "postcss": "8.5.6",
    "tsx": "4.20.5",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4"
  },
  "allowScripts": {
    "@prisma/client@6.16.2": true,
    "prisma@6.16.2": true,
    "@prisma/engines@6.16.2": true,
    "@tailwindcss/oxide@4.1.13": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.34.5": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}