{
  "name": "fireoxine",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,admin -c magenta,cyan,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:admin\"",
    "dev:api": "npm run dev -w @fireoxine/api",
    "dev:web": "npm run dev -w @fireoxine/web",
    "dev:admin": "npm run dev -w @fireoxine/admin",
    "build": "prisma generate && npm run build -w @fireoxine/api && npm run build -w @fireoxine/web && npm run build -w @fireoxine/admin",
    "build:check": "NEXT_DIST_DIR=.next-check npm run build -w @fireoxine/api && NEXT_DIST_DIR=.next-check npm run build -w @fireoxine/web && NEXT_DIST_DIR=.next-check npm run build -w @fireoxine/admin",
    "start": "concurrently -n api,web,admin -c magenta,cyan,yellow \"npm:start:api\" \"npm:start:web\" \"npm:start:admin\"",
    "start:api": "npm run start -w @fireoxine/api",
    "start:web": "npm run start -w @fireoxine/web",
    "start:admin": "npm run start -w @fireoxine/admin",
    "typecheck": "tsc -b --pretty",
    "lint": "npm run lint -w @fireoxine/web && npm run lint -w @fireoxine/admin",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run images:fetch && npm run db:seed",
    "db:studio": "prisma studio",
    "images:fetch": "tsx prisma/fetch-catalogue-images.ts",
    "placeholders:on": "tsx prisma/attach-placeholders.ts",
    "placeholders:off": "tsx prisma/clear-placeholders.ts",
    "db:provision": "prisma migrate deploy && npm run images:fetch && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2"
  },
  "devDependencies": {
    "prisma": "6.16.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "concurrently": "9.1.2",
    "@types/node": "24.5.2"
  },
  "allowScripts": {
    "@prisma/client@6.16.2": true,
    "prisma@6.16.2": true,
    "@prisma/engines@6.16.2": true,
    "@tailwindcss/oxide@4.1.13": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.34.5": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
