# Each app has its own .env. Copy this file into the three app directories and
# fill in what that app needs.

# --- apps/api (the only app with database access) -------------------------
# Postgres in every environment, including local development:
#   docker run -d --name fireoxine-pg -p 5432:5432 \
#     -e POSTGRES_USER=fireoxine -e POSTGRES_PASSWORD=fireoxine \
#     -e POSTGRES_DB=fireoxine postgres:16-alpine
DATABASE_URL="postgresql://fireoxine:fireoxine@localhost:5432/fireoxine?schema=public"

# Signs the session tokens the API issues. The API refuses to start without it.
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-before-deploying"

# --- apps/web and apps/admin ----------------------------------------------
# Server-to-server base URL for the API. On a platform with a private network,
# use the internal address — the browser never calls this.
API_URL="http://localhost:3002"

# Public base URL for uploaded media, which the API serves from /uploads.
# This one IS resolved by the visitor's browser, so it must be publicly
# reachable. It is usually NOT the same host as API_URL.
NEXT_PUBLIC_MEDIA_URL="http://localhost:3002"

# --- apps/admin only ------------------------------------------------------
# Used for the "view on site" link out of the product editor.
WEB_URL="http://localhost:3000"
