# Local development uses SQLite. For production switch the `datasource db`
# provider in prisma/schema.prisma to "postgresql" and point this at Postgres.
DATABASE_URL="file:./dev.db"

# Generate a real one with: openssl rand -base64 32
# The value in .env is a development placeholder and must not ship.
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true
