# Each app has its own .env. Copy this file into the three app directories and
# fill in what that app needs.

# --- apps/api (the only app with database access) -------------------------
# SQLite path is relative to prisma/schema.prisma, not to the app directory.
DATABASE_URL="file:./dev.db"
# Signs the session tokens the API issues. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me-before-deploying"

# --- apps/web and apps/admin ----------------------------------------------
# Server-side base URL for the API. The browser never calls it directly.
API_URL="http://localhost:3002"
# Public base URL for uploaded media, which the API serves from /uploads.
NEXT_PUBLIC_MEDIA_URL="http://localhost:3002"
